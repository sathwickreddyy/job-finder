{
  "name": "jobops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3210",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3210",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:test": "tsx scripts/seed-test.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "zod": "4.6.5",
    "pdf-parse": "2.4.5",
    "pdf-lib": "1.17.1",
    "papaparse": "5.7.0",
    "dotenv": "18.0.5",
    "lucide-react": "1.49.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "@types/papaparse": "5.5.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
