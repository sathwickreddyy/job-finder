+// India-focused job sites. Only LinkedIn and Naukri have verified, stable search URLs.
+
+export type JobSite = {
+  name: string;
+  host: string;
+  bestFor: string;
+  url: string;
+  search?: (role: string, city: string) => string;
+};
+
+export const slug = (value: string) =>
+  value
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-|-$/g, "");
+
+export const jobSearchSites: JobSite[] = [
+  {
