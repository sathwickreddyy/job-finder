# Host-side maintenance/test commands use this URL. Compose overrides it with postgres:5432.
DATABASE_URL=postgresql://jobops:jobops_local_only@127.0.0.1:5549/jobops
APP_URL=http://127.0.0.1:3210
# Optional exact LAN/MagicDNS hostname aliases, comma-separated (no URLs, ports or wildcards).
# Example: m4-pro,m4-pro.your-tailnet.ts.net
JOBOPS_LOCAL_HOSTS=
# Leave empty for trusted-LAN use. Required (32+ characters) for public-host deployments.
JOBOPS_ACCESS_TOKEN=
# Compose mounts this host directory; existing PDFs stay here across rebuilds.
STORAGE_ROOT=./data/uploads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3210/api/mail/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:3210/api/mail/outlook/callback
# Generate a 32-byte key as documented in README before connecting an inbox.
# Keep the original key value when renaming GMAIL_TOKEN_ENCRYPTION_KEY.
MAIL_TOKEN_ENCRYPTION_KEY=
