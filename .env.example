# ─── Config backend ────────────────────────────────────────────────────────
# local  = read/write YAML + resumes from CONFIG_DIR / RESUME_DIR
# http   = read-only, pull config/resumes from CONFIG_SOURCE_URL / RESUME_SOURCE_URL
CONFIG_BACKEND=local
CONFIG_DIR=config
RESUME_DIR=resumes
CONFIG_SOURCE_URL=
RESUME_SOURCE_URL=

# ─── Storage ───────────────────────────────────────────────────────────────
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/job_search.db

# ─── Notion (optional) ─────────────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations and share the
# database with it. Copy the database ID from the URL.
NOTION_TOKEN=
NOTION_JOBS_DATABASE_ID=

# ─── LLM (optional; rule scorer is used if both missing) ──────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ─── Microsoft Graph / Outlook (optional skeleton) ─────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Gmail (optional skeleton) ─────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=
